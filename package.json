{
  "name": "prais",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "prepare": "bash scripts/git-setup.sh",
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "setup:git": "bash scripts/git-setup.sh",
    "sync": "git fetch -q origin main && git push prais origin/main:refs/heads/main"
  }
}
