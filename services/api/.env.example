# Modelo: en local, una API key de Google AI Studio
GOOGLE_GENAI_API_KEY=

# En Cloud Run, Vertex AI con la cuenta de servicio (sin API key)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# Opcional: otro modelo de Gemini
# PRAIS_MODEL=gemini-3.8-flash   # en Vertex hay que fijar una versión: el alias -latest no existe

# Fuentes: cada una se activa cuando su key está puesta (ver agents/contracts.md)
FIRECRAWL_API_KEY=
APIFY_TOKEN=                # Instagram y TikTok. Sin token, esas dos fuentes quedan apagadas
# USE_MOCK_SOURCE=false   # apaga la fuente de ejemplo

# WhatsApp con Kapso
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=

# URL https pública de esta API. WhatsApp descarga ahí la foto marcada «Imagen de Prais».
# En Cloud Run ya está SELF_URL. En local, la URL del túnel.
# PUBLIC_BASE_URL=

# En Cloud Run las claves de arriba no van sueltas: llegan como un JSON en APP_SECRETS
# (secreto prais-api-secrets) y app/config.py las vuelca al entorno al arrancar.

# Conversaciones del agente. Sin esta variable quedan en memoria y se pierden al reiniciar.
# En Cloud Run la escribe infra/33-postgres.sh (Postgres por el socket de Cloud SQL):
# postgresql+asyncpg://prais:CLAVE@/prais?host=/cloudsql/PROYECTO:REGION:prais-pg
# SESSION_DATABASE_URL=
