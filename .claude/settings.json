{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-main.mjs\"",
            "statusMessage": "Revisando que el push no vaya a main..."
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-docs.mjs\"",
            "statusMessage": "Revisando si el commit necesita actualizar los docs..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "firecrawl": {
      "source": {
        "source": "github",
        "repo": "firecrawl/firecrawl-claude-plugin"
      }
    },
    "apify": {
      "source": {
        "source": "github",
        "repo": "apify/apify-claude-code-plugin"
      }
    }
  },
  "enabledPlugins": {
    "firecrawl@firecrawl": true,
    "apify@apify": true
  }
}
